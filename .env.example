# Hermes Agent OS — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Store secrets in GitHub Secrets and n8n Credentials only.

# ── Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # @PI_Ink_Hermes_bot token from BotFather
TELEGRAM_WEBHOOK_SECRET=      # Random string you set for webhook security (optional but recommended)

# ── Hermes Internal Routing ───────────────────────────
HERMES_WEBHOOK_URL=           # Internal URL where Hermes receives routed messages
HERMES_INTERNAL_TOKEN=        # Bearer token for Hermes internal auth

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # Service role key (never anon key for n8n)

# ── n8n ───────────────────────────────────────────────
N8N_BASE_URL=                 # Your n8n instance URL (e.g. https://n8n.yourdomain.com)
N8N_WEBHOOK_PATH=telegram-hermes
